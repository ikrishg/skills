{
  "name": "@ikrishg/skills",
  "private": true,
  "license": "MIT",
  "version": "0.1.0",
  "scripts": {
    "test": "node --test scripts/*.test.mjs",
    "catalog:sync": "node scripts/sync-readme-catalog.mjs --write",
    "catalog:check": "node scripts/sync-readme-catalog.mjs --check",
    "zips:build": "node scripts/build-zips.mjs",
    "validate": "node scripts/validate.mjs",
    "check": "npm test && npm run zips:build && npm run validate",
    "skills:check": "node scripts/check-skill.mjs . --collection",
    "release": "semantic-release"
  },
  "bin": {
    "skills-check": "scripts/check-skill.mjs"
  },
  "files": [
    "scripts/check-skill.mjs",
    "scripts/markdown-links.mjs",
    "docs/skill-check.md"
  ],
  "dependencies": {
    "gray-matter": "^4.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ikrishg/skills.git"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "semantic-release": "^25.0.9"
  }
}
